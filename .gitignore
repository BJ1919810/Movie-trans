# ==================== 模型与权重（用 Download_*.py 下载）====================
# IndexTTS-2.5 权重（python Download_indextts25.py）
index-tts/checkpoints/
# ASR / pyannote 模型（python Download_models.py 或首次运行自动下载）
asr/models/
# UVR5 人声/伴奏分离权重（体积大：610MB + 60MB），不进仓库，
# 用 python Download_models.py 下载到 uvr5/uvr5_weights/（含 sha256 校验）
uvr5/uvr5_weights/*.pth
uvr5/uvr5_weights/*.ckpt
# 根目录 hf_cache（辅助模型缓存）
checkpoints/
# BigVGAN CUDA 扩展构建产物
index-tts/indextts/s2mel/modules/bigvgan/alias_free_activation/cuda/build/
# NeMo 文本正规化 tagger 缓存（运行时生成）
index-tts/indextts/utils/tagger_cache/

